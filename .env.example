DATABASE_URL=
ANTHROPIC_API_KEY=
APP_ENV=
OTEL_EXPORTER_OTLP_ENDPOINT=
API_URL=
CORS_ALLOWED_ORIGINS=
# Set to claude-haiku-4-5-20251001 to cut integration test costs ~10x
# TEST_MODEL=claude-haiku-4-5-20251001
# Set to true to disable real LLM calls — enables cost-free UI testing
# MOCK_LLM=true
# Set to true alongside MOCK_LLM=true to trigger ask_user_required in E2E tests
# MOCK_ASK_USER=true
# LLM provider: anthropic (default) or ollama (local dev)
LLM_PROVIDER=
# Ollama settings (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
API_PORT=8000
WEB_PORT=3000
# Job runner backend: in_process (default/local), celery (Docker Compose), aca (Azure)
JOB_RUNNER_BACKEND=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# ACA Jobs (Azure production only)
ACA_SIMULATION_JOB_RESOURCE_ID=
AZURE_ARM_TOKEN=
# Storage
LAKEHOUSE_PATH=
# Rate limiting
RATE_LIMIT_GLOBAL_PER_MIN=
RATE_LIMIT_PER_USER_PER_MIN=
